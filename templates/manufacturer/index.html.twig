{% extends 'base.html.twig' %}

{% block title %}Manufacturers | AssetCare{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>Manufacturers</h1>
            <p class="text-muted mb-0">
                Manage manufacturers assigned to your assets.
            </p>
        </div>

        <a href="{{ path('app_manufacturer_create') }}" class="btn btn-primary">Add manufacturer</a>
    </div>

    {% if manufacturers is empty %}
        <div class="alert alert-info">
            No manufacturers have been added yet.
        </div>
    {% else %}
        <div class="table-responsive">
            <table class="table table-striped align-middle">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Website</th>
                        <th>Support email</th>
                        <th>Support phone</th>
                    </tr>
                </thead>
                <tbody>
                    {% for manufacturer in manufacturers %}
                        <tr>
                            <td>{{ manufacturer.name }}</td>
                            <td>{{ manufacturer.website ?? '—' }}</td>
                            <td>{{ manufacturer.supportEmail ?? '—' }}</td>
                            <td>{{ manufacturer.supportPhone ?? '—' }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
{% endblock %}